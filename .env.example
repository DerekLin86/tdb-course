# ==============================================================================
# Triple Dream Ballet (TDB) - Synology NAS Runtime Environment Variables
# ==============================================================================

# GitHub Container Registry (GHCR) 儲存庫路徑（請填寫小寫：<github-username-or-org>/<repo-name>）
IMAGE_REPO=dereklin86/tdb-course

# 容器映像檔標籤（預設最新版 latest）
IMAGE_TAG=latest

# 前端服務外部暴露端口（Synology NAS 建議設定 8080 或 8088 避免與 DSM 80 衝突）
FRONTEND_PORT=4200

# SQLite 資料庫於 Synology NAS 的持久化掛載路徑
# 建議先於 NAS「File Station」建立共享資料夾路徑，例如：/volume1/docker/triple-d-ballet/data
DATA_VOLUME_PATH=/volume1/docker/triple-d-ballet/data

# 執行環境模式（development: 開發模式，允許自動示範資料與重置；production: 正式模式，保護真實資料並鎖定重置 API）
ENVIRONMENT=production

# SQLite 資料庫連線字串（預設會依 ENVIRONMENT 指向 triple_d_ballet.prod.db 或 triple_d_ballet.dev.db）
# DATABASE_URL=sqlite:////app/data/triple_d_ballet.prod.db
